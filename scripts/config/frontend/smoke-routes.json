{
  "version": 1,
  "description": "Browser smoke expectations for critical AIOS frontend routes. Keep this as the single route source for scripts/frontend/smoke-frontend-routes.mjs and docs/FRONTEND_QUALITY_SYSTEM.md.",
  "routes": [
    {
      "path": "/",
      "description": "Home page should render the public product entry surface.",
      "minBodyTextLength": 120,
      "expectedText": [
        "Groland AIOS",
        "核心能力矩阵",
        "快速入口"
      ],
      "performanceBudget": {
        "maxCls": 0.1,
        "maxDomContentLoadedMs": 3000,
        "maxDomNodeCount": 2500,
        "maxLcpMs": 2500,
        "maxLoadMs": 5000,
        "maxResourceCount": 80,
        "maxResourceTransferKb": 1800,
        "maxScriptTransferKb": 1400
      }
    },
    {
      "path": "/login",
      "description": "Login page should render the form, not only an empty shell.",
      "minBodyTextLength": 20,
      "expectedText": [
        "Groland AIOS",
        "用户名",
        "密码",
        "登 录"
      ],
      "authenticatedProfile": {
        "authState": "authenticated",
        "minBodyTextLength": 120,
        "expectedText": [
          "Groland AIOS",
          "核心能力矩阵",
          "快速入口"
        ],
        "expectedFinalPath": "/"
      },
      "performanceBudget": {
        "maxCls": 0.1,
        "maxDomContentLoadedMs": 2500,
        "maxDomNodeCount": 1500,
        "maxLcpMs": 2500,
        "maxLoadMs": 4500,
        "maxResourceCount": 70,
        "maxResourceTransferKb": 1600,
        "maxScriptTransferKb": 1300
      }
    },
    {
      "path": "/dashboard",
      "description": "Dashboard is public-readable and should expose the main dashboard shell.",
      "minBodyTextLength": 80,
      "expectedText": [
        "Groland Dashboard",
        "Overview",
        "月"
      ],
      "performanceInteractionSelector": "nav[aria-label=\"平台切换\"] button",
      "performanceBudget": {
        "maxCls": 0.1,
        "maxDomContentLoadedMs": 5000,
        "maxDomNodeCount": 4500,
        "maxInpMs": 200,
        "maxLcpMs": 2500,
        "maxLoadMs": 8000,
        "maxResourceCount": 100,
        "maxResourceTransferKb": 2400,
        "maxScriptTransferKb": 1800
      }
    },
    {
      "path": "/dashboard?tab=douyin&dimension=live",
      "description": "Authenticated dashboard live route should keep critical dashboard runtime CSS variables after Vite build extraction.",
      "authState": "authenticated",
      "enabledByDefault": false,
      "minBodyTextLength": 80,
      "expectedText": [
        "Groland Dashboard"
      ],
      "expectedCssVariables": [
        "--dashboard-inverse-text",
        "--dashboard-panel-border",
        "--dashboard-brand-tab-shadow",
        "--dashboard-live-card-border"
      ],
      "performanceInteractionSelector": "nav[aria-label=\"平台切换\"] button",
      "expectedFinalPath": "/dashboard",
      "expectedFinalSearchIncludes": [
        "tab=douyin",
        "dimension=live"
      ],
      "performanceBudget": {
        "maxCls": 0.1,
        "maxDomContentLoadedMs": 6000,
        "maxDomNodeCount": 5500,
        "maxInpMs": 200,
        "maxLcpMs": 2500,
        "maxLoadMs": 10000,
        "maxResourceCount": 120,
        "maxResourceTransferKb": 2800,
        "maxScriptTransferKb": 2200
      },
      "authenticatedProfile": {
        "authState": "authenticated",
        "minBodyTextLength": 80,
        "expectedText": [
          "Groland Dashboard"
        ],
        "expectedCssVariables": [
          "--dashboard-inverse-text",
          "--dashboard-panel-border",
          "--dashboard-brand-tab-shadow",
          "--dashboard-live-card-border"
        ],
        "expectedFinalPath": "/dashboard",
        "expectedFinalSearchIncludes": [
          "tab=douyin",
          "dimension=live"
        ]
      }
    },
    {
      "path": "/docs",
      "description": "Docs page should render the local documentation workspace.",
      "minBodyTextLength": 120,
      "expectedText": [
        "AIOS 文档中心",
        "按任务分区",
        "推荐阅读顺序"
      ],
      "performanceBudget": {
        "maxCls": 0.1,
        "maxDomContentLoadedMs": 3000,
        "maxDomNodeCount": 2500,
        "maxLcpMs": 2500,
        "maxLoadMs": 5000,
        "maxResourceCount": 80,
        "maxResourceTransferKb": 1800,
        "maxScriptTransferKb": 1400
      }
    },
    {
      "path": "/reports/weekly",
      "description": "Anonymous weekly report access should resolve to the login route with redirect intent.",
      "authState": "anonymous-redirect",
      "enabledByDefault": false,
      "minBodyTextLength": 20,
      "authenticatedProfile": {
        "authState": "authenticated",
        "minBodyTextLength": 80,
        "settleTimeoutMs": 20000,
        "expectedText": [
          "Groland Weekly Update"
        ],
        "expectedFinalPath": "/reports/weekly"
      },
      "expectedText": [
        "Groland AIOS",
        "用户名",
        "密码"
      ],
      "expectedFinalPath": "/login",
      "expectedFinalSearchIncludes": [
        "redirect=%2Freports%2Fweekly"
      ]
    },
    {
      "path": "/ops/dataops",
      "description": "Anonymous DataOps access should resolve to the login route with redirect intent.",
      "authState": "anonymous-redirect",
      "enabledByDefault": false,
      "minBodyTextLength": 20,
      "expectedText": [
        "Groland AIOS",
        "用户名",
        "密码"
      ],
      "expectedFinalPath": "/login",
      "expectedFinalSearchIncludes": [
        "redirect=%2Fops%2Fdataops"
      ]
    },
    {
      "path": "/marketing",
      "description": "Anonymous marketing workspace access should resolve to the login route with redirect intent.",
      "authState": "anonymous-redirect",
      "enabledByDefault": false,
      "minBodyTextLength": 20,
      "expectedText": [
        "Groland AIOS",
        "用户名",
        "密码"
      ],
      "expectedFinalPath": "/login",
      "expectedFinalSearchIncludes": [
        "redirect=%2Fmarketing"
      ]
    }
  ]
}
