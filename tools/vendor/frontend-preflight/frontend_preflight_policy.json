{
  "version": 1,
  "default_profile": "prod",
  "profiles": {
    "base": {
      "window": {
        "days": 7,
        "top": 5
      },
      "sources": {
        "include_rotated": true,
        "include_gzip_rotated": true,
        "max_rotated_files": 64
      }
    },
    "prod": {
      "extends": "base",
      "contexts": [
        "prod"
      ],
      "checks": {
        "min_events": 1,
        "no_data_action": "fail",
        "max_parse_error_rate_pct": 5,
        "parse_error_action": "warn"
      },
      "thresholds": {
        "deny_rate_pct": 35,
        "codes": [
          {
            "code": "PREFLIGHT_MISSING",
            "min_count": 1
          },
          {
            "code": "PREFLIGHT_INVALID_CODE",
            "min_count": 1
          },
          {
            "code": "RUNTIME_ERROR",
            "min_count": 1
          }
        ],
        "tier_deny_rate_pct": {
          "L1-V": 40,
          "L2": 30
        },
        "deny_trend_days": 3,
        "tier_deny_trend_days": {
          "L2": 3
        },
        "trend_min_events": 3,
        "trend_min_step_pct": 1
      }
    },
    "ci": {
      "extends": "base",
      "contexts": [
        "ci"
      ],
      "checks": {
        "min_events": 1,
        "no_data_action": "fail",
        "max_parse_error_rate_pct": 5,
        "parse_error_action": "fail"
      },
      "thresholds": {
        "deny_rate_pct": 45,
        "codes": [
          {
            "code": "RUNTIME_ERROR",
            "min_count": 1
          }
        ],
        "tier_deny_rate_pct": {
          "L2": 40
        },
        "deny_trend_days": 4,
        "tier_deny_trend_days": {
          "L2": 4
        },
        "trend_min_events": 3,
        "trend_min_step_pct": 1
      }
    },
    "test": {
      "extends": "base",
      "contexts": [
        "test"
      ],
      "checks": {
        "min_events": 1,
        "no_data_action": "warn",
        "max_parse_error_rate_pct": 10,
        "parse_error_action": "warn"
      },
      "thresholds": {
        "deny_rate_pct": 80,
        "tier_deny_rate_pct": {
          "L2": 80
        },
        "deny_trend_days": 5,
        "tier_deny_trend_days": {
          "L2": 5
        },
        "trend_min_events": 3,
        "trend_min_step_pct": 5
      }
    }
  }
}
