# Merge these non-secret render-worker settings into the dedicated private env file.
# /work must be a writable disk volume owned by UID/GID 10001, one worker per volume.
CONTENT_PRODUCTION_WORK_DIR=/work
# Sampled logical-byte budget (8 GiB); not a filesystem hard quota.
CONTENT_PRODUCTION_WORK_MAX_BYTES=8589934592
# Keep at least 2 GiB free on the underlying filesystem.
CONTENT_PRODUCTION_WORK_MIN_FREE_BYTES=2147483648

# Optional paid caption review: 0=off, 1=review, 2=revision candidate, 3=rereview.
# Per render job, not a daily monetary budget. Unknown outcomes consume a slot.
AIOS_CAPTION_WORKER_MAX_CALLS=0
# Render at most one reviewed line-only candidate as a separate inspection video.
# Requires a candidate rereview (normally MAX_CALLS=3); never replaces original output.
AIOS_CAPTION_RENDER_CANDIDATE=false
# Configure these only in the dedicated private worker env; responses protocol.
AIOS_CAPTION_BASE_URL=
AIOS_CAPTION_API_KEY=
AIOS_CAPTION_REVIEW_MODEL=

# Optional visual review of already treated picture slots, after the main render.
# 0=off; 1..3 calls per render job, one call per slot. Unreviewed slots remain pending.
# Independent of caption review; no automatic retry/erasure or delivery approval.
# Must accept Responses input_video (treated comparison: 2 fps; final raw-source window: 5 fps)
# and input_image (high detail).
# Up to 3 caption bands share the same call; input tokens can increase.
# Keep credentials in private worker env.
# Final raw-source windows use one visual observation plus one text comparison call.
# Both consume this shared 0..3 budget; limit=1 preserves observation only, not a text verdict.
AIOS_VISUAL_REVIEW_MAX_CALLS=0
AIOS_VISUAL_REVIEW_BASE_URL=
AIOS_VISUAL_REVIEW_API_KEY=
AIOS_VISUAL_REVIEW_MODEL=

# framework_remix only (AI 创作中心框架混剪成片)：逐段响度平衡 + 两遍 loudnorm + 统一编码。
# 默认值即下列取值；留空使用默认，非法值使任务在测量阶段失败。
CONTENT_PRODUCTION_REMIX_SEGMENT_LUFS=-16
CONTENT_PRODUCTION_REMIX_SEGMENT_MAX_GAIN_DB=12
CONTENT_PRODUCTION_REMIX_OUTPUT_LUFS=-14
CONTENT_PRODUCTION_REMIX_OUTPUT_TRUE_PEAK=-1
CONTENT_PRODUCTION_REMIX_OUTPUT_LRA=11
CONTENT_PRODUCTION_REMIX_VIDEO_BITRATE=6M
CONTENT_PRODUCTION_REMIX_VIDEO_MAXRATE=7.5M
CONTENT_PRODUCTION_REMIX_VIDEO_BUFSIZE=12M
CONTENT_PRODUCTION_REMIX_X264_PRESET=medium
CONTENT_PRODUCTION_REMIX_AUDIO_BITRATE=128k
CONTENT_PRODUCTION_REMIX_NORMALIZE_TIMEOUT_SECONDS=1800
