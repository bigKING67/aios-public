# DataOps ETL runtime/cache artifacts (keep ETL scripts in image context)
etl/groland_postgres/.venv
etl/groland_postgres/.uv-cache
etl/groland_postgres/.prefect_home
etl/groland_postgres/.prefect_logs
etl/groland_postgres/.ace-tool
etl/groland_postgres/.DS_Store
etl/groland_postgres/**/__pycache__
etl/groland_postgres/**/*.pyc

# Host-local credentials must never enter any image build context.
**/.env*
!**/.env.example

# Final deny after the env-example exception: never traverse host runtime data.
.dataops/
